{
    "name": "lsimons-template-workspace",
    "version": "0.0.0",
    "private": true,
    "description": "Workspace root for lsimons-template (TypeScript side)",
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@10.34.5",
    "scripts": {
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "typecheck": "pnpm -r --parallel typecheck",
        "test": "pnpm -r --parallel test",
        "build": "pnpm -r --parallel build"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^4.1.10",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
